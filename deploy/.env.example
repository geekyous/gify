APP_PORT=24800
FRONTEND_PORT=24824
SECRET_KEY=<openssl rand -hex 32>

# 前端本机构建镜像时时注入的 API 基址（浏览器可达的 API 入口，含协议与端口）
# 例：VITE_API_BASE_URL=http://gify.example.internal:8000
VITE_API_BASE_URL=
# CORS 允许的前端来源（逗号分隔，含协议与端口），须与前端实际访问地址一致
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# SameSite：前后端同注册域用 lax（默认）；跨注册域用 none（需 HTTPS）
COOKIE_SAMESITE=lax

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gify
POSTGRES_PASSWORD=gify
POSTGRES_DB=gify

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=gify
REDIS_DB=0

# 初始管理员（首次登录强制改密）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-on-first-login

# ACR 信息
ACR_REGISTRY=<registry_address>
ACR_NAMESPACE=<namespace>
ACR_USERNAME=<username>
ACR_PASSWORD=<password>
