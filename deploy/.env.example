APP_PORT=8000
FRONTEND_PORT=8080
SECRET_KEY=change-me-openssl-rand-hex-32

# 前端构建时注入的 API 基址（浏览器可达的 API 入口，含协议与端口）
# 例：VITE_API_BASE_URL=http://gify.example.internal:8000
VITE_API_BASE_URL=

# CORS 允许的前端来源（逗号分隔，含协议与端口），须与前端实际访问地址一致
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# SameSite：前后端同注册域用 lax（默认）；跨注册域用 none（需 HTTPS）
COOKIE_SAMESITE=lax

POSTGRES_USER=gify
POSTGRES_PASSWORD=gify
POSTGRES_DB=gify
# 以下两项是宿主机本地开发的默认值；app 容器内由 compose 覆盖为服务名地址
DATABASE_URL=postgresql+psycopg://gify:gify@localhost:5432/gify
REDIS_URL=redis://localhost:6379/0

# 初始管理员（首次登录强制改密）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-on-first-login
