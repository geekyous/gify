APP_PORT=8000
SECRET_KEY=change-me-openssl-rand-hex-32

# CORS 允许的前端来源（逗号分隔，含协议与端口）
CORS_ORIGINS=http://localhost:5173

# SameSite：前后端同注册域用 lax（默认）；跨注册域用 none（需 HTTPS）
COOKIE_SAMESITE=lax

POSTGRES_USER=gify
POSTGRES_PASSWORD=gify
POSTGRES_DB=gify
DATABASE_URL=postgresql+psycopg://gify:gify@localhost:5432/gify
REDIS_URL=redis://localhost:6379/0

# 初始管理员（首次登录强制改密）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-on-first-login
